// Kaapi Connect - Prisma Schema
// A Kerala-first, secular matrimony platform
// Matches based on interests, values, and compatibility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// CORE ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
}

enum InterestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MessageType {
  TEXT
  IMAGE
}

enum ReportReason {
  INAPPROPRIATE_PHOTOS
  FAKE_PROFILE
  HARASSMENT
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum VerificationType {
  EMAIL
  PHONE
  PHOTO
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  NEW_MATCH
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  NEW_MESSAGE
  PROFILE_VIEW
  PROFILE_LIKE
  SUPER_LIKE
  DAILY_MATCHES
}

enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  PROFESSIONAL
}

enum BodyType {
  SLIM
  AVERAGE
  ATHLETIC
  CURVY
  PLUS_SIZE
}

enum FamilyType {
  NUCLEAR
  JOINT
  SINGLE_PARENT
}

enum IncomeRange {
  BELOW_3_LAKHS
  THREE_TO_FIVE_LAKHS
  FIVE_TO_SEVEN_LAKHS
  SEVEN_TO_TEN_LAKHS
  TEN_TO_FIFTEEN_LAKHS
  FIFTEEN_TO_TWENTY_LAKHS
  TWENTY_TO_THIRTY_LAKHS
  ABOVE_THIRTY_LAKHS
  PREFER_NOT_TO_SAY
}

enum ActivityType {
  PROFILE_VIEW
  LIKE_SENT
  LIKE_RECEIVED
  SUPERLIKE_SENT
  SUPERLIKE_RECEIVED
  INTEREST_SENT
  INTEREST_RECEIVED
  INTEREST_ACCEPTED
  INTEREST_DECLINED
  MATCH_CREATED
  MESSAGE_SENT
  MESSAGE_RECEIVED
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PREMIUM_PLUS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

// ============================================
// KAAPI CONNECT ENUMS (Values & Kerala Context)
// ============================================

enum PoliticalLeaning {
  PROGRESSIVE
  LIBERAL
  MODERATE
  CONSERVATIVE
  APOLITICAL
  PREFER_NOT_TO_SAY
}

enum KeralaDistrict {
  THIRUVANANTHAPURAM
  KOLLAM
  PATHANAMTHITTA
  ALAPPUZHA
  KOTTAYAM
  IDUKKI
  ERNAKULAM
  THRISSUR
  PALAKKAD
  MALAPPURAM
  KOZHIKODE
  WAYANAD
  KANNUR
  KASARAGOD
}

enum DiasporaLocation {
  NONE
  GULF_UAE
  GULF_SAUDI
  GULF_QATAR
  GULF_KUWAIT
  GULF_OMAN
  GULF_BAHRAIN
  USA
  UK
  AUSTRALIA
  CANADA
  EUROPE
  SINGAPORE
  OTHER
}

enum KeralaConnection {
  VERY_STRONG
  MODERATE
  WEAK
}

enum SocialStyle {
  INTROVERTED
  EXTROVERTED
  AMBIVERT
  PREFER_NOT_TO_SAY
}

// ============================================
// MODELS
// ============================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  emailVerificationToken String? @unique
  emailVerifiedAt DateTime?
  password      String?
  name          String?
  image         String?
  phoneNumber   String?    @unique
  phoneVerified Boolean    @default(false)
  onboardingCompleted Boolean @default(false)
  status        UserStatus @default(ACTIVE)
  role          UserRole   @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastActive    DateTime   @default(now())

  // Relations
  profile            Profile?
  accounts           Account[]
  sessions           Session[]
  partnerPreferences PartnerPreferences?
  photos             Photo[]
  sentInterests      Interest[]          @relation("SentInterests")
  receivedInterests  Interest[]          @relation("ReceivedInterests")
  matches1           Match[]             @relation("MatchUser1")
  matches2           Match[]             @relation("MatchUser2")
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")
  likesGiven         Like[]              @relation("LikesGiven")
  likesReceived      Like[]              @relation("LikesReceived")
  blocksInitiated    Block[]             @relation("BlocksInitiated")
  blocksReceived     Block[]             @relation("BlocksReceived")
  reportsInitiated   Report[]            @relation("ReportsInitiated")
  reportsReceived    Report[]            @relation("ReportsReceived")
  notifications      Notification[]
  verifications      Verification[]
  activities         Activity[]          @relation("UserActivities")
  activityTargets    Activity[]          @relation("ActivityTargets")
  subscription       Subscription?
  dailyQuotas        DailyQuota[]
  personalityPrompts PersonalityPrompt[] @relation("UserPersonalityPrompts")

  @@index([email])
  @@index([status])
  @@index([lastActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Info
  dateOfBirth DateTime
  gender      Gender
  aboutMe     String?  @db.Text

  // Interests & Values (KAAPI CONNECT - replaces faith fields)
  interestTags              String[]  @default([])  // Array of interest tag slugs
  politicalLeaning          PoliticalLeaning?
  socialValues              String[]  @default([])  // feminist, egalitarian, traditional, modern_flexible
  socialStyle               SocialStyle?

  // Relationship Goals
  relationshipTimeline      String?  // casual_to_serious, life_partner_soon, open, no_rush
  wantChildren              String?  // yes, no, undecided
  livingArrangementPreference String? // nuclear, open_to_extended, doesnt_matter
  relocationFlexibility     String?  // anywhere, prefer_kerala, prefer_current_city, international_ok

  // Communication & Personality
  weekendPreference         String[]  @default([])  // outdoor_activities, staying_home, socializing, family_time
  communicationStyle        String?   // very_expressive, moderate, reserved

  // Physical Attributes
  height          Int? // in cm
  bodyType        BodyType?
  complexion      String?
  languages       String[]  @default([])

  // Education & Career
  educationLevel  EducationLevel?
  fieldOfStudy    String?
  occupation      String?
  incomeRange     IncomeRange?

  // Family Background
  parentsOccupation String?
  siblingsCount     Int?
  birthOrder        String?
  familyType        FamilyType?
  familyValues      String? @db.Text

  // Lifestyle
  drinking       String?
  smoking        String?
  dietPreference String?
  hobbies        String? @db.Text

  // Location & Kerala Connection (KAAPI CONNECT)
  city                String?
  state               String?
  country             String?
  homeDistrict        KeralaDistrict?
  diasporaLocation    DiasporaLocation?
  keralaConnection    KeralaConnection?
  languagePreference  String? // malayalam_primary, malayalam_english, english_primary
  openToRelocate      Boolean @default(false)

  // Privacy
  isVisible       Boolean @default(true)
  visibilityMode  String  @default("all") // all, matched_only, hidden

  // Profile Stats
  profileViews    Int     @default(0)
  completionPercentage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([gender])
  @@index([isVisible])
  @@index([homeDistrict])
  @@index([politicalLeaning])
}

model Photo {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  publicId      String?  // Cloudinary public ID
  order         Int      @default(0)
  isPrimary     Boolean  @default(false)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([isPrimary])
}

model PersonalityPrompt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserPersonalityPrompts", fields: [userId], references: [id], onDelete: Cascade)

  prompt    String   // The question/prompt text
  answer    String   @db.Text // User's answer
  order     Int      @default(0) // Display order (0, 1, 2 for max 3 prompts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, order])
}

model PartnerPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Preferences
  ageMin         Int?
  ageMax         Int?
  heightMin      Int?     // in cm
  heightMax      Int?     // in cm
  educationLevels String[] @default([]) // Array of EducationLevel
  locations      String[] @default([]) // Array of cities/states
  incomeRange    String?

  // Interest & Values Preferences (KAAPI CONNECT - replaces denominations)
  preferredInterests        String[]  @default([])  // Array of interest tag slugs
  preferredPoliticalLeanings String[] @default([]) // Array of PoliticalLeaning values
  preferredSocialValues     String[]  @default([])  // Array of social values
  preferredKeralaDistricts  String[]  @default([])  // Array of KeralaDistrict values
  okayWithDiaspora          Boolean?  // Whether open to diaspora partners

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Interest {
  id         String         @id @default(cuid())
  senderId   String
  receiverId String
  sender     User           @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User           @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String?        @db.Text
  status     InterestStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId])
}

model Match {
  id         String    @id @default(cuid())
  user1Id    String
  user2Id    String
  user1      User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2      User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  matchedAt  DateTime  @default(now())
  messages   Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id         String      @id @default(cuid())
  matchId    String
  match      Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId   String
  receiverId String
  sender     User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String      @db.Text
  type       MessageType @default(TEXT)
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([matchId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
}

model Like {
  id          String   @id @default(cuid())
  likerId     String
  likedId     String
  isSuperLike Boolean  @default(false)
  liker       User     @relation("LikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  liked       User     @relation("LikesReceived", fields: [likedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([likerId, likedId])
  @@index([likedId])
  @@index([isSuperLike])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String
  reporter    User         @relation("ReportsInitiated", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  reviewedBy  String?
  reviewNote  String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([reportedId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  content   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Verification {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationType
  data       String?            @db.Text // Could store photo URL or verification code
  status     VerificationStatus @default(PENDING)
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId, type])
  @@index([status])
}

model SuperLikeQuota {
  id              String   @id @default(cuid())
  userId          String   @unique
  remainingLikes  Int      @default(3)
  weekStartDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Activity {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  type         ActivityType
  targetUserId String?
  targetUser   User?        @relation("ActivityTargets", fields: [targetUserId], references: [id], onDelete: Cascade)
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([targetUserId])
  @@index([type])
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            SubscriptionTier   @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @default(now())
  endDate         DateTime?
  autoRenew       Boolean            @default(false)
  paymentMethod   String?
  lastPaymentDate DateTime?
  amount          Float?
  currency        String             @default("INR")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([tier])
}

model DailyQuota {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @default(now()) @db.Date
  likesUsed         Int      @default(0)
  superLikesUsed    Int      @default(0)
  interestsUsed     Int      @default(0)
  profileViewsUsed  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}
