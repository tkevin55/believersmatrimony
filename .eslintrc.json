{
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "globals": {
    "NodeJS": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-debugger": "error",
    "no-unreachable": "error",
    "no-empty": "warn",
    "no-constant-condition": "warn",
    "prefer-const": "warn",
    "no-var": "error",
    "react/no-unescaped-entities": "warn",
    "jsx-a11y/alt-text": "warn"
  }
}
